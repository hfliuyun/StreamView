if(NOT STREAMVIEW_DEPLOYED_DIR)
    set(STREAMVIEW_DEPLOYED_DIR "$ENV{STREAMVIEW_DEPLOYED_DIR}")
endif()
if(NOT STREAMVIEW_PACKAGE_VERSION)
    set(STREAMVIEW_PACKAGE_VERSION "$ENV{STREAMVIEW_PACKAGE_VERSION}")
endif()
if(NOT IS_DIRECTORY "${STREAMVIEW_DEPLOYED_DIR}")
    message(FATAL_ERROR "STREAMVIEW_DEPLOYED_DIR must name a verified deployment tree")
endif()
if(NOT STREAMVIEW_PACKAGE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "STREAMVIEW_PACKAGE_VERSION must be X.Y.Z")
endif()

set(CPACK_GENERATOR ZIP)
set(CPACK_PACKAGE_NAME StreamView)
set(CPACK_PACKAGE_VERSION "${STREAMVIEW_PACKAGE_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION "Read-only bit-level media structure analyzer")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Read-only bit-level media structure analyzer")
set(CPACK_PACKAGE_FILE_NAME "StreamView-${STREAMVIEW_PACKAGE_VERSION}-windows-x64")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
# Preserve the exact DLL/plugin tree already deployed and smoke-tested.
set(CPACK_INSTALLED_DIRECTORIES "${STREAMVIEW_DEPLOYED_DIR};/")
set(CPACK_INSTALL_CMAKE_PROJECTS "")
