@spec("ISO/IEC 14496-12:2015", "8.6.1.2")
@description("Time to Sample entry.")
struct TimeToSampleEntry {
    bits<32> sample_count
        @description("Number of consecutive samples with this delta.");
    bits<32> sample_delta
        @description("Delta of these samples in timescale units.");
}

@spec("ISO/IEC 14496-12:2015", "8.6.1.2")
@description("Time to Sample box payload.")
struct TimeToSampleBox {
    bits<8> version
        @description("Version (0).");
    bits<24> flags
        @description("Flags.");
    bits<32> entry_count
        @description("Number of time-to-sample entries.");
    if (version == 0) {
        computed<u64> table_bytes = entry_count * 8;
        @lazy(table_bytes) bytes entries @window(TimeToSampleEntry, entry_count);
    } else {
        unsupported("Unsupported stts FullBox version") at version;
    }
}

@spec("ISO/IEC 14496-12:2015", "8.7.4")
@description("Sample to Chunk entry.")
struct SampleToChunkEntry {
    bits<32> first_chunk
        @description("First chunk index using this description.");
    bits<32> samples_per_chunk
        @description("Number of samples in each chunk.");
    bits<32> sample_description_index
        @description("Sample description index for these samples.");
}

@spec("ISO/IEC 14496-12:2015", "8.7.4")
@description("Sample to Chunk box payload.")
struct SampleToChunkBox {
    bits<8> version
        @description("Version (0).");
    bits<24> flags
        @description("Flags.");
    bits<32> entry_count
        @description("Number of sample-to-chunk entries.");
    if (version == 0) {
        computed<u64> table_bytes = entry_count * 12;
        @lazy(table_bytes) bytes entries @window(SampleToChunkEntry, entry_count);
    } else {
        unsupported("Unsupported stsc FullBox version") at version;
    }
}

@spec("ISO/IEC 14496-12:2015", "8.7.3.2")
@description("Sample Size entry.")
struct SampleSizeEntry {
    bits<32> entry_size
        @description("Size of individual sample in bytes.");
}

@spec("ISO/IEC 14496-12:2015", "8.7.3.2")
@description("Sample Size box payload.")
struct SampleSizeBox {
    bits<8> version
        @description("Version (0).");
    bits<24> flags
        @description("Flags.");
    bits<32> sample_size
        @description("Default sample size (if 0, individual sizes follow in table).");
    bits<32> sample_count
        @description("Number of samples.");
    if (version == 0) {
        if (sample_size == 0) {
            computed<u64> table_bytes = sample_count * 4;
            @lazy(table_bytes) bytes entries @window(SampleSizeEntry, sample_count);
        }
    } else {
        unsupported("Unsupported stsz FullBox version") at version;
    }
}

@spec("ISO/IEC 14496-12:2015", "8.7.5")
@description("32-bit Chunk Offset entry.")
struct ChunkOffsetEntry {
    bits<32> chunk_offset
        @description("32-bit byte offset of chunk from beginning of file.");
}

@spec("ISO/IEC 14496-12:2015", "8.7.5")
@description("32-bit Chunk Offset box payload.")
struct ChunkOffsetBox {
    bits<8> version
        @description("Version (0).");
    bits<24> flags
        @description("Flags.");
    bits<32> entry_count
        @description("Number of chunk offset entries.");
    if (version == 0) {
        computed<u64> table_bytes = entry_count * 4;
        @lazy(table_bytes) bytes entries @window(ChunkOffsetEntry, entry_count);
    } else {
        unsupported("Unsupported stco FullBox version") at version;
    }
}

@spec("ISO/IEC 14496-12:2015", "8.7.5")
@description("64-bit Chunk Offset entry.")
struct ChunkLargeOffsetEntry {
    bits<64> chunk_offset
        @description("64-bit byte offset of chunk from beginning of file.");
}

@spec("ISO/IEC 14496-12:2015", "8.7.5")
@description("64-bit Chunk Offset box payload.")
struct ChunkLargeOffsetBox {
    bits<8> version
        @description("Version (0).");
    bits<24> flags
        @description("Flags.");
    bits<32> entry_count
        @description("Number of 64-bit chunk offset entries.");
    if (version == 0) {
        computed<u64> table_bytes = entry_count * 8;
        @lazy(table_bytes) bytes entries @window(ChunkLargeOffsetEntry, entry_count);
    } else {
        unsupported("Unsupported co64 FullBox version") at version;
    }
}

@spec("ISO/IEC 14496-12:2015", "4.2")
@description("ISO Base Media File Format box.")
struct Box {
    bits<32> size
        @description("Box size in bytes. 1 indicates 64-bit largesize; 0 indicates extends to EOF.");
    bits<32> type
        @description("Box FourCC type identifier.");
    if (type == 0x66747970) {
        if (size == 1) {
            bits<64> ftyp_largesize
                @description("64-bit box size in bytes.");
            bits<32> ftyp_large_major_brand
                @description("Major brand identifier.");
            bits<32> ftyp_large_minor_version
                @description("Minor version of major brand.");
            computed<u64> ftyp_large_brand_count = (ftyp_largesize - 24) / 4;
            repeat (ftyp_large_brand_count, 64) {
                bits<32> ftyp_large_compatible_brands
                    @description("Compatible brand identifier.");
            }
        } else {
            if (size == 0) {
                bits<32> ftyp_eof_major_brand
                    @description("Major brand identifier.");
                bits<32> ftyp_eof_minor_version
                    @description("Minor version of major brand.");
                computed<u64> ftyp_eof_brand_count = available_bytes() / 4;
                repeat (ftyp_eof_brand_count, 64) {
                    bits<32> ftyp_eof_compatible_brands
                        @description("Compatible brand identifier.");
                }
            } else {
                bits<32> major_brand
                    @description("Major brand identifier.");
                bits<32> minor_version
                    @description("Minor version of major brand.");
                computed<u64> brand_count = (size - 16) / 4;
                repeat (brand_count, 64) {
                    bits<32> compatible_brands
                        @description("Compatible brand identifier.");
                }
            }
        }
    } else {
        if (type == 0x6D6F6F76) {
            if (size == 1) {
                bits<64> moov_largesize;
                computed<u64> moov_large_payload_bytes = moov_largesize - 16;
                @lazy(moov_large_payload_bytes) bytes moov_large_payload @container(Box);
            } else {
                if (size == 0) {
                    computed<u64> moov_eof_payload_bytes = available_bytes();
                    @lazy(moov_eof_payload_bytes) bytes moov_eof_payload @container(Box);
                } else {
                    computed<u64> moov_payload_bytes = size - 8;
                    @lazy(moov_payload_bytes) bytes moov_payload @container(Box);
                }
            }
        } else {
            if (type == 0x6D766864) {
                if (size == 1) {
                    bits<64> mvhd_largesize;
                }
                bits<8> mvhd_version
                    @description("Version of movie header box (0 or 1).");
                bits<24> mvhd_flags
                    @description("Flags (reserved).");
                if (mvhd_version == 1) {
                    bits<64> mvhd_v1_creation_time
                        @description("Creation time (seconds since 1904-01-01).");
                    bits<64> mvhd_v1_modification_time
                        @description("Modification time (seconds since 1904-01-01).");
                    bits<32> mvhd_v1_timescale
                        @description("Time scale units per second.");
                    bits<64> mvhd_v1_duration
                        @description("Duration of movie in timescale units.");
                } else {
                    if (mvhd_version == 0) {
                        bits<32> mvhd_v0_creation_time
                            @description("Creation time (seconds since 1904-01-01).");
                        bits<32> mvhd_v0_modification_time
                            @description("Modification time (seconds since 1904-01-01).");
                        bits<32> mvhd_v0_timescale
                            @description("Time scale units per second.");
                        bits<32> mvhd_v0_duration
                            @description("Duration of movie in timescale units.");
                    } else {
                        unsupported("Unsupported mvhd FullBox version") at mvhd_version;
                    }
                }
                bits<32> mvhd_rate
                    @description("Playback rate (fixed-point 16.16, 0x00010000 is 1.0).");
                bits<16> mvhd_volume
                    @description("Audio volume (fixed-point 8.8, 0x0100 is full).");
                bits<16> mvhd_reserved;
                bits<64> mvhd_reserved_2;
                computed<u64> mvhd_matrix_count = 9;
                repeat (mvhd_matrix_count, 9) {
                    bits<32> mvhd_matrix;
                }
                computed<u64> mvhd_pre_defined_count = 6;
                repeat (mvhd_pre_defined_count, 6) {
                    bits<32> mvhd_pre_defined;
                }
                bits<32> mvhd_next_track_id
                    @description("Next track ID to assign.");
            } else {
                if (type == 0x7472616B) {
                    if (size == 1) {
                        bits<64> trak_largesize;
                        computed<u64> trak_large_payload_bytes = trak_largesize - 16;
                        @lazy(trak_large_payload_bytes) bytes trak_large_payload @container(Box);
                    } else {
                        if (size == 0) {
                            computed<u64> trak_eof_payload_bytes = available_bytes();
                            @lazy(trak_eof_payload_bytes) bytes trak_eof_payload @container(Box);
                        } else {
                            computed<u64> trak_payload_bytes = size - 8;
                            @lazy(trak_payload_bytes) bytes trak_payload @container(Box);
                        }
                    }
                } else {
                    if (type == 0x746B6864) {
                        if (size == 1) {
                            bits<64> tkhd_largesize;
                        }
                        bits<8> tkhd_version
                            @description("Version of track header box (0 or 1).");
                        bits<24> tkhd_flags
                            @description("Flags (track enabled, in movie, in preview).");
                        if (tkhd_version == 1) {
                            bits<64> tkhd_v1_creation_time
                                @description("Creation time (seconds since 1904-01-01).");
                            bits<64> tkhd_v1_modification_time
                                @description("Modification time (seconds since 1904-01-01).");
                            bits<32> tkhd_v1_track_id
                                @description("Track identifier.");
                            bits<32> tkhd_v1_reserved;
                            bits<64> tkhd_v1_duration
                                @description("Track duration in movie timescale.");
                        } else {
                            if (tkhd_version == 0) {
                                bits<32> tkhd_v0_creation_time
                                    @description("Creation time (seconds since 1904-01-01).");
                                bits<32> tkhd_v0_modification_time
                                    @description("Modification time (seconds since 1904-01-01).");
                                bits<32> tkhd_v0_track_id
                                    @description("Track identifier.");
                                bits<32> tkhd_v0_reserved;
                                bits<32> tkhd_v0_duration
                                    @description("Track duration in movie timescale.");
                            } else {
                                unsupported("Unsupported tkhd FullBox version") at tkhd_version;
                            }
                        }
                        bits<64> tkhd_reserved_2;
                        bits<16> tkhd_layer
                            @description("Front-to-back ordering layer.");
                        bits<16> tkhd_alternate_group
                            @description("Track alternate group identifier.");
                        bits<16> tkhd_volume
                            @description("Audio volume (fixed-point 8.8).");
                        bits<16> tkhd_reserved_3;
                        computed<u64> tkhd_matrix_count = 9;
                        repeat (tkhd_matrix_count, 9) {
                            bits<32> tkhd_matrix;
                        }
                        bits<32> tkhd_width
                            @description("Visual presentation width (fixed-point 16.16).");
                        bits<32> tkhd_height
                            @description("Visual presentation height (fixed-point 16.16).");
                    } else {
                        if (type == 0x65647473) {
                            if (size == 1) {
                                bits<64> edts_largesize;
                                computed<u64> edts_large_payload_bytes = edts_largesize - 16;
                                @lazy(edts_large_payload_bytes) bytes edts_large_payload @container(Box);
                            } else {
                                if (size == 0) {
                                    computed<u64> edts_eof_payload_bytes = available_bytes();
                                    @lazy(edts_eof_payload_bytes) bytes edts_eof_payload @container(Box);
                                } else {
                                    computed<u64> edts_payload_bytes = size - 8;
                                    @lazy(edts_payload_bytes) bytes edts_payload @container(Box);
                                }
                            }
                        } else {
                            if (type == 0x656C7374) {
                                if (size == 1) {
                                    bits<64> elst_largesize;
                                }
                                bits<8> elst_version
                                    @description("Version of edit list box (0 or 1).");
                                bits<24> elst_flags
                                    @description("Flags.");
                                if (elst_version == 1) {
                                    bits<32> elst_v1_entry_count
                                        @description("Number of edit list entries.");
                                    repeat (elst_v1_entry_count, 64) {
                                        bits<64> elst_v1_segment_duration
                                            @description("Segment duration in movie timescale.");
                                        bits<64> elst_v1_media_time
                                            @description("Starting media time (-1 for empty edit).");
                                        bits<16> elst_v1_media_rate_integer
                                            @description("Playback rate integer portion (1 is normal).");
                                        bits<16> elst_v1_media_rate_fraction
                                            @description("Playback rate fractional portion.");
                                    }
                                } else {
                                    if (elst_version == 0) {
                                        bits<32> elst_v0_entry_count
                                            @description("Number of edit list entries.");
                                        repeat (elst_v0_entry_count, 64) {
                                            bits<32> elst_v0_segment_duration
                                                @description("Segment duration in movie timescale.");
                                            bits<32> elst_v0_media_time
                                                @description("Starting media time (-1 for empty edit).");
                                            bits<16> elst_v0_media_rate_integer
                                                @description("Playback rate integer portion (1 is normal).");
                                            bits<16> elst_v0_media_rate_fraction
                                                @description("Playback rate fractional portion.");
                                        }
                                    } else {
                                        unsupported("Unsupported elst FullBox version") at elst_version;
                                    }
                                }
                            } else {
                                if (type == 0x6D646961) {
                                    if (size == 1) {
                                        bits<64> mdia_largesize;
                                        computed<u64> mdia_large_payload_bytes = mdia_largesize - 16;
                                        @lazy(mdia_large_payload_bytes) bytes mdia_large_payload @container(Box);
                                    } else {
                                        if (size == 0) {
                                            computed<u64> mdia_eof_payload_bytes = available_bytes();
                                            @lazy(mdia_eof_payload_bytes) bytes mdia_eof_payload @container(Box);
                                        } else {
                                            computed<u64> mdia_payload_bytes = size - 8;
                                            @lazy(mdia_payload_bytes) bytes mdia_payload @container(Box);
                                        }
                                    }
                                } else {
                                    if (type == 0x6D646864) {
                                        if (size == 1) {
                                            bits<64> mdhd_largesize;
                                        }
                                        bits<8> mdhd_version
                                            @description("Version of media header box (0 or 1).");
                                        bits<24> mdhd_flags
                                            @description("Flags.");
                                        if (mdhd_version == 1) {
                                            bits<64> mdhd_v1_creation_time
                                                @description("Creation time (seconds since 1904-01-01).");
                                            bits<64> mdhd_v1_modification_time
                                                @description("Modification time (seconds since 1904-01-01).");
                                            bits<32> mdhd_v1_timescale
                                                @description("Media timescale units per second.");
                                            bits<64> mdhd_v1_duration
                                                @description("Media duration in media timescale units.");
                                        } else {
                                            if (mdhd_version == 0) {
                                                bits<32> mdhd_v0_creation_time
                                                    @description("Creation time (seconds since 1904-01-01).");
                                                bits<32> mdhd_v0_modification_time
                                                    @description("Modification time (seconds since 1904-01-01).");
                                                bits<32> mdhd_v0_timescale
                                                    @description("Media timescale units per second.");
                                                bits<32> mdhd_v0_duration
                                                    @description("Media duration in media timescale units.");
                                            } else {
                                                unsupported("Unsupported mdhd FullBox version") at mdhd_version;
                                            }
                                        }
                                        bits<1> mdhd_pad;
                                        bits<15> mdhd_language
                                            @description("ISO-639-2/T 3-character language code (packed 3x5-bit).");
                                        bits<16> mdhd_pre_defined;
                                    } else {
                                        if (type == 0x68646C72) {
                                            if (size == 1) {
                                                bits<64> hdlr_largesize;
                                            }
                                            bits<8> hdlr_version
                                                @description("Version of handler box.");
                                            bits<24> hdlr_flags
                                                @description("Flags.");
                                            bits<32> hdlr_pre_defined;
                                            bits<32> hdlr_handler_type
                                                @description("Handler type FourCC (vide, soun, hint, etc.).");
                                            bits<32> hdlr_reserved_0;
                                            bits<32> hdlr_reserved_1;
                                            bits<32> hdlr_reserved_2;
                                            if (size == 1) {
                                                computed<u64> hdlr_large_name_bytes = hdlr_largesize - 40;
                                                @lazy(hdlr_large_name_bytes) bytes hdlr_large_name
                                                    @description("Handler component name string.");
                                            } else {
                                                if (size == 0) {
                                                    computed<u64> hdlr_eof_name_bytes = available_bytes();
                                                    @lazy(hdlr_eof_name_bytes) bytes hdlr_eof_name
                                                        @description("Handler component name string.");
                                                } else {
                                                    computed<u64> hdlr_name_bytes = size - 32;
                                                    @lazy(hdlr_name_bytes) bytes hdlr_name
                                                        @description("Handler component name string.");
                                                }
                                            }
                                        } else {
                                            if (type == 0x6D696E66) {
                                                if (size == 1) {
                                                    bits<64> minf_largesize;
                                                    computed<u64> minf_large_payload_bytes = minf_largesize - 16;
                                                    @lazy(minf_large_payload_bytes) bytes minf_large_payload @container(Box);
                                                } else {
                                                    if (size == 0) {
                                                        computed<u64> minf_eof_payload_bytes = available_bytes();
                                                        @lazy(minf_eof_payload_bytes) bytes minf_eof_payload @container(Box);
                                                    } else {
                                                        computed<u64> minf_payload_bytes = size - 8;
                                                        @lazy(minf_payload_bytes) bytes minf_payload @container(Box);
                                                    }
                                                }
                                            } else {
                                                if (type == 0x7374626C) {
                                                    if (size == 1) {
                                                        bits<64> stbl_largesize;
                                                        computed<u64> stbl_large_payload_bytes = stbl_largesize - 16;
                                                        @lazy(stbl_large_payload_bytes) bytes stbl_large_payload @container(Box);
                                                    } else {
                                                        if (size == 0) {
                                                            computed<u64> stbl_eof_payload_bytes = available_bytes();
                                                            @lazy(stbl_eof_payload_bytes) bytes stbl_eof_payload @container(Box);
                                                        } else {
                                                            computed<u64> stbl_payload_bytes = size - 8;
                                                            @lazy(stbl_payload_bytes) bytes stbl_payload @container(Box);
                                                        }
                                                    }
                                                } else {
                                                    if (type == 0x73747473) {
                                                        if (size == 1) {
                                                            bits<64> stts_largesize;
                                                            computed<u64> stts_large_payload_bytes = stts_largesize - 16;
                                                            @lazy(stts_large_payload_bytes) bytes stts_large_payload @container(TimeToSampleBox);
                                                        } else {
                                                            if (size == 0) {
                                                                computed<u64> stts_eof_payload_bytes = available_bytes();
                                                                @lazy(stts_eof_payload_bytes) bytes stts_eof_payload @container(TimeToSampleBox);
                                                            } else {
                                                                computed<u64> stts_payload_bytes = size - 8;
                                                                @lazy(stts_payload_bytes) bytes stts_payload @container(TimeToSampleBox);
                                                            }
                                                        }
                                                    } else {
                                                        if (type == 0x73747363) {
                                                            if (size == 1) {
                                                                bits<64> stsc_largesize;
                                                                computed<u64> stsc_large_payload_bytes = stsc_largesize - 16;
                                                                @lazy(stsc_large_payload_bytes) bytes stsc_large_payload @container(SampleToChunkBox);
                                                            } else {
                                                                if (size == 0) {
                                                                    computed<u64> stsc_eof_payload_bytes = available_bytes();
                                                                    @lazy(stsc_eof_payload_bytes) bytes stsc_eof_payload @container(SampleToChunkBox);
                                                                } else {
                                                                    computed<u64> stsc_payload_bytes = size - 8;
                                                                    @lazy(stsc_payload_bytes) bytes stsc_payload @container(SampleToChunkBox);
                                                                }
                                                            }
                                                        } else {
                                                            if (type == 0x7374737A) {
                                                                if (size == 1) {
                                                                    bits<64> stsz_largesize;
                                                                    computed<u64> stsz_large_payload_bytes = stsz_largesize - 16;
                                                                    @lazy(stsz_large_payload_bytes) bytes stsz_large_payload @container(SampleSizeBox);
                                                                } else {
                                                                    if (size == 0) {
                                                                        computed<u64> stsz_eof_payload_bytes = available_bytes();
                                                                        @lazy(stsz_eof_payload_bytes) bytes stsz_eof_payload @container(SampleSizeBox);
                                                                    } else {
                                                                        computed<u64> stsz_payload_bytes = size - 8;
                                                                        @lazy(stsz_payload_bytes) bytes stsz_payload @container(SampleSizeBox);
                                                                    }
                                                                }
                                                            } else {
                                                                if (type == 0x7374636F) {
                                                                    if (size == 1) {
                                                                        bits<64> stco_largesize;
                                                                        computed<u64> stco_large_payload_bytes = stco_largesize - 16;
                                                                        @lazy(stco_large_payload_bytes) bytes stco_large_payload @container(ChunkOffsetBox);
                                                                    } else {
                                                                        if (size == 0) {
                                                                            computed<u64> stco_eof_payload_bytes = available_bytes();
                                                                            @lazy(stco_eof_payload_bytes) bytes stco_eof_payload @container(ChunkOffsetBox);
                                                                        } else {
                                                                            computed<u64> stco_payload_bytes = size - 8;
                                                                            @lazy(stco_payload_bytes) bytes stco_payload @container(ChunkOffsetBox);
                                                                        }
                                                                    }
                                                                } else {
                                                                    if (type == 0x636F3634) {
                                                                        if (size == 1) {
                                                                            bits<64> co64_largesize;
                                                                            computed<u64> co64_large_payload_bytes = co64_largesize - 16;
                                                                            @lazy(co64_large_payload_bytes) bytes co64_large_payload @container(ChunkLargeOffsetBox);
                                                                        } else {
                                                                            if (size == 0) {
                                                                                computed<u64> co64_eof_payload_bytes = available_bytes();
                                                                                @lazy(co64_eof_payload_bytes) bytes co64_eof_payload @container(ChunkLargeOffsetBox);
                                                                            } else {
                                                                                computed<u64> co64_payload_bytes = size - 8;
                                                                                @lazy(co64_payload_bytes) bytes co64_payload @container(ChunkLargeOffsetBox);
                                                                            }
                                                                        }
                                                                    } else {
                                                                        if (type == 0x73747364) {
                                                                            if (size == 1) {
                                                                                bits<64> stsd_largesize;
                                                                            }
                                                                            bits<8> stsd_version
                                                                                @description("Version (0).");
                                                                            bits<24> stsd_flags
                                                                                @description("Flags.");
                                                                            bits<32> stsd_entry_count
                                                                                @description("Number of sample entries.");
                                                                            if (stsd_version == 0) {
                                                                                if (size == 1) {
                                                                                    computed<u64> stsd_large_entries_bytes = stsd_largesize - 24;
                                                                                    @lazy(stsd_large_entries_bytes) bytes stsd_large_entries
                                                                                        @description("Sample description entries.")
                                                                                        @container(Box);
                                                                                } else {
                                                                                    if (size == 0) {
                                                                                        computed<u64> stsd_eof_entries_bytes = available_bytes();
                                                                                        @lazy(stsd_eof_entries_bytes) bytes stsd_eof_entries
                                                                                            @description("Sample description entries.")
                                                                                            @container(Box);
                                                                                    } else {
                                                                                        computed<u64> stsd_entries_bytes = size - 16;
                                                                                        @lazy(stsd_entries_bytes) bytes stsd_entries
                                                                                            @description("Sample description entries.")
                                                                                            @container(Box);
                                                                                    }
                                                                                }
                                                                            } else {
                                                                                unsupported("Unsupported stsd FullBox version") at stsd_version;
                                                                            }
                                                                        } else {
                                                                            if (type == 0x61766331) {
                                                                                if (size == 1) {
                                                                                    bits<64> avc1_largesize;
                                                                                }
                                                                                bits<48> avc1_reserved_entry
                                                                                    @description("Reserved 6 bytes.");
                                                                                bits<16> avc1_data_reference_index
                                                                                    @description("Data reference index.");
                                                                                bits<16> avc1_pre_defined
                                                                                    @description("Pre-defined (0).");
                                                                                bits<16> avc1_reserved_1
                                                                                    @description("Reserved (0).");
                                                                                bits<32> avc1_pre_defined_1_0
                                                                                    @description("Pre-defined 1/3 (0).");
                                                                                bits<32> avc1_pre_defined_1_1
                                                                                    @description("Pre-defined 2/3 (0).");
                                                                                bits<32> avc1_pre_defined_1_2
                                                                                    @description("Pre-defined 3/3 (0).");
                                                                                bits<16> avc1_width
                                                                                    @description("Visual display width in pixels.");
                                                                                bits<16> avc1_height
                                                                                    @description("Visual display height in pixels.");
                                                                                bits<32> avc1_horizresolution
                                                                                    @description("Horizontal resolution (0x00480000 = 72 dpi).");
                                                                                bits<32> avc1_vertresolution
                                                                                    @description("Vertical resolution (0x00480000 = 72 dpi).");
                                                                                bits<32> avc1_reserved_2
                                                                                    @description("Reserved (0).");
                                                                                bits<16> avc1_frame_count
                                                                                    @description("Frames per sample (usually 1).");
                                                                                bits<64> avc1_compressorname_0
                                                                                    @description("Compressor name 1/4.");
                                                                                bits<64> avc1_compressorname_1
                                                                                    @description("Compressor name 2/4.");
                                                                                bits<64> avc1_compressorname_2
                                                                                    @description("Compressor name 3/4.");
                                                                                bits<64> avc1_compressorname_3
                                                                                    @description("Compressor name 4/4.");
                                                                                bits<16> avc1_depth
                                                                                    @description("Color depth (0x0018 = 24-bit).");
                                                                                bits<16> avc1_pre_defined_2
                                                                                    @description("Pre-defined (-1).");
                                                                                if (size == 1) {
                                                                                    computed<u64> avc1_large_children_bytes = avc1_largesize - 94;
                                                                                    @lazy(avc1_large_children_bytes) bytes avc1_large_children
                                                                                        @description("Visual sample entry child boxes.")
                                                                                        @container(Box);
                                                                                } else {
                                                                                    if (size == 0) {
                                                                                        computed<u64> avc1_eof_children_bytes = available_bytes();
                                                                                        @lazy(avc1_eof_children_bytes) bytes avc1_eof_children
                                                                                            @description("Visual sample entry child boxes.")
                                                                                            @container(Box);
                                                                                    } else {
                                                                                        computed<u64> avc1_children_bytes = size - 86;
                                                                                        @lazy(avc1_children_bytes) bytes avc1_children
                                                                                            @description("Visual sample entry child boxes.")
                                                                                            @container(Box);
                                                                                    }
                                                                                }
                                                                            } else {
                                                                                if (type == 0x6D703461) {
                                                                                    if (size == 1) {
                                                                                        bits<64> mp4a_largesize;
                                                                                    }
                                                                                    bits<48> mp4a_reserved_entry
                                                                                        @description("Reserved 6 bytes.");
                                                                                    bits<16> mp4a_data_reference_index
                                                                                        @description("Data reference index.");
                                                                                    bits<64> mp4a_reserved_1
                                                                                        @description("Reserved 8 bytes (0).");
                                                                                    bits<16> mp4a_channelcount
                                                                                        @description("Channel count.");
                                                                                    bits<16> mp4a_samplesize
                                                                                        @description("Sample size in bits (16).");
                                                                                    bits<16> mp4a_pre_defined
                                                                                        @description("Pre-defined (0).");
                                                                                    bits<16> mp4a_reserved_2
                                                                                        @description("Reserved (0).");
                                                                                    bits<32> mp4a_samplerate
                                                                                        @description("Sample rate (16.16 fixed-point).");
                                                                                    if (size == 1) {
                                                                                        computed<u64> mp4a_large_children_bytes = mp4a_largesize - 44;
                                                                                        @lazy(mp4a_large_children_bytes) bytes mp4a_large_children
                                                                                            @description("Audio sample entry child boxes.")
                                                                                            @container(Box);
                                                                                    } else {
                                                                                        if (size == 0) {
                                                                                            computed<u64> mp4a_eof_children_bytes = available_bytes();
                                                                                            @lazy(mp4a_eof_children_bytes) bytes mp4a_eof_children
                                                                                                @description("Audio sample entry child boxes.")
                                                                                                @container(Box);
                                                                                        } else {
                                                                                            computed<u64> mp4a_children_bytes = size - 36;
                                                                                            @lazy(mp4a_children_bytes) bytes mp4a_children
                                                                                                @description("Audio sample entry child boxes.")
                                                                                                @container(Box);
                                                                                        }
                                                                                    }
                                                                                } else {
                                                                                    if (type == 0x61766343) {
                                                                                        if (size == 1) {
                                                                                            bits<64> avcC_largesize;
                                                                                        }
                                                                                        bits<8> configurationVersion
                                                                                            @description("Configuration version (1).");
                                                                                        if (configurationVersion == 1) {
                                                                                            bits<8> avcProfileIndication
                                                                                                @description("AVC profile indication.");
                                                                                            bits<8> profile_compatibility
                                                                                                @description("Profile compatibility flags.");
                                                                                            bits<8> avcLevelIndication
                                                                                                @description("AVC level indication.");
                                                                                            bits<6> reserved_6bits
                                                                                                @description("Reserved 6 bits (111111b).");
                                                                                            bits<2> lengthSizeMinusOne
                                                                                                @description("NAL unit length field size minus one.");
                                                                                            bits<3> reserved_3bits
                                                                                                @description("Reserved 3 bits (111b).");
                                                                                            bits<5> numOfSequenceParameterSets
                                                                                                @description("Number of sequence parameter sets.");
                                                                                            repeat (numOfSequenceParameterSets, 31) {
                                                                                                bits<16> sequenceParameterSetLength
                                                                                                    @description("SPS NAL unit length in bytes.");
                                                                                                @lazy(sequenceParameterSetLength) bytes sequenceParameterSetNALUnit
                                                                                                    @description("SPS NAL unit bytes.")
                                                                                                    @target_format("video.h264.nal");
                                                                                            }
                                                                                            bits<8> numOfPictureParameterSets
                                                                                                @description("Number of picture parameter sets.");
                                                                                            repeat (numOfPictureParameterSets, 64) {
                                                                                                bits<16> pictureParameterSetLength
                                                                                                    @description("PPS NAL unit length in bytes.");
                                                                                                @lazy(pictureParameterSetLength) bytes pictureParameterSetNALUnit
                                                                                                    @description("PPS NAL unit bytes.")
                                                                                                    @target_format("video.h264.nal");
                                                                                            }
                                                                                        } else {
                                                                                            unsupported("Unsupported avcC configurationVersion") at configurationVersion;
                                                                                        }
                                                                                    } else {
                                                                                        if (type == 0x65736473) {
                                                                                            if (size == 1) {
                                                                                                bits<64> esds_largesize;
                                                                                            }
                                                                                            bits<8> esds_version
                                                                                                @description("Version (0).");
                                                                                            bits<24> esds_flags
                                                                                                @description("Flags.");
                                                                                            if (esds_version == 0) {
                                                                                                bits<8> es_tag
                                                                                                    @description("ES_DescrTag (0x03).");
                                                                                                bits<1> es_len_more0;
                                                                                                bits<7> es_len_val0;
                                                                                                if (es_len_more0 == 1) {
                                                                                                    bits<1> es_len_more1;
                                                                                                    bits<7> es_len_val1;
                                                                                                    if (es_len_more1 == 1) {
                                                                                                        bits<1> es_len_more2;
                                                                                                        bits<7> es_len_val2;
                                                                                                        if (es_len_more2 == 1) {
                                                                                                            bits<1> es_len_more3;
                                                                                                            bits<7> es_len_val3;
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                                bits<16> es_id
                                                                                                    @description("ES ID.");
                                                                                                bits<1> streamDependenceFlag
                                                                                                    @description("Stream dependence flag.");
                                                                                                bits<1> urlFlag
                                                                                                    @description("URL flag.");
                                                                                                bits<1> ocrStreamFlag
                                                                                                    @description("OCR stream flag.");
                                                                                                bits<5> streamPriority
                                                                                                    @description("Stream priority.");
                                                                                                bits<8> dc_tag
                                                                                                    @description("DecoderConfigDescrTag (0x04).");
                                                                                                bits<1> dc_len_more0;
                                                                                                bits<7> dc_len_val0;
                                                                                                if (dc_len_more0 == 1) {
                                                                                                    bits<1> dc_len_more1;
                                                                                                    bits<7> dc_len_val1;
                                                                                                    if (dc_len_more1 == 1) {
                                                                                                        bits<1> dc_len_more2;
                                                                                                        bits<7> dc_len_val2;
                                                                                                        if (dc_len_more2 == 1) {
                                                                                                            bits<1> dc_len_more3;
                                                                                                            bits<7> dc_len_val3;
                                                                                                        }
                                                                                                    }
                                                                                                }
                                                                                                bits<8> objectTypeIndication
                                                                                                    @description("Object type indication (0x40 for Audio ISO/IEC 14496-3 AAC).");
                                                                                                bits<6> streamType
                                                                                                    @description("Stream type (0x05 for AudioStream).");
                                                                                                bits<1> upStream
                                                                                                    @description("Upstream flag.");
                                                                                                bits<1> reserved_1bit
                                                                                                    @description("Reserved bit (1).");
                                                                                                bits<24> bufferSizeDB
                                                                                                    @description("Buffer size in bytes.");
                                                                                                bits<32> maxBitrate
                                                                                                    @description("Maximum bitrate.");
                                                                                                bits<32> avgBitrate
                                                                                                    @description("Average bitrate.");
                                                                                                bits<8> dsi_tag
                                                                                                    @description("DecSpecificInfoTag (0x05).");
                                                                                                bits<1> dsi_len_more0;
                                                                                                bits<7> dsi_len_val0;
                                                                                                if (dsi_len_more0 == 1) {
                                                                                                    bits<1> dsi_len_more1;
                                                                                                    bits<7> dsi_len_val1;
                                                                                                    if (dsi_len_more1 == 1) {
                                                                                                        bits<1> dsi_len_more2;
                                                                                                        bits<7> dsi_len_val2;
                                                                                                        if (dsi_len_more2 == 1) {
                                                                                                            bits<1> dsi_len_more3;
                                                                                                            bits<7> dsi_len_val3;
                                                                                                            computed<u64> asc_len4 = dsi_len_val0 * 2097152 + dsi_len_val1 * 16384 + dsi_len_val2 * 128 + dsi_len_val3;
                                                                                                            @lazy(asc_len4) bytes asc_bytes4
                                                                                                                @description("AudioSpecificConfig payload.")
                                                                                                                @target_format("audio.aac.asc");
                                                                                                        } else {
                                                                                                            computed<u64> asc_len3 = dsi_len_val0 * 16384 + dsi_len_val1 * 128 + dsi_len_val2;
                                                                                                            @lazy(asc_len3) bytes asc_bytes3
                                                                                                                @description("AudioSpecificConfig payload.")
                                                                                                                @target_format("audio.aac.asc");
                                                                                                        }
                                                                                                    } else {
                                                                                                        computed<u64> asc_len2 = dsi_len_val0 * 128 + dsi_len_val1;
                                                                                                        @lazy(asc_len2) bytes asc_bytes2
                                                                                                            @description("AudioSpecificConfig payload.")
                                                                                                            @target_format("audio.aac.asc");
                                                                                                    }
                                                                                                } else {
                                                                                                    computed<u64> asc_len1 = dsi_len_val0;
                                                                                                    @lazy(asc_len1) bytes asc_bytes1
                                                                                                        @description("AudioSpecificConfig payload.")
                                                                                                        @target_format("audio.aac.asc");
                                                                                                }
                                                                                            } else {
                                                                                                unsupported("Unsupported esds FullBox version") at esds_version;
                                                                                            }
                                                                                        } else {
                                                                                            if (type == 0x6D6F6F66) {
                                                                                                unsupported("fragmented MP4 (moof/traf) is outside the v0.1 subset") at type;
                                                                                            } else {
                                                                                                if (size == 1) {
                                                                                                    bits<64> largesize
                                                                                                        @description("64-bit box size in bytes.");
                                                                                                    computed<u64> large_payload_bytes = largesize - 16;
                                                                                                    @lazy(large_payload_bytes) bytes large_payload
                                                                                                        @description("Box payload data.");
                                                                                                } else {
                                                                                                    if (size == 0) {
                                                                                                        computed<u64> eof_payload_bytes = available_bytes();
                                                                                                        @lazy(eof_payload_bytes) bytes eof_payload
                                                                                                            @description("Box payload data extending to EOF.");
                                                                                                    } else {
                                                                                                        computed<u64> payload_bytes = size - 8;
                                                                                                        @lazy(payload_bytes) bytes payload
                                                                                                            @description("Box payload data.");
                                                                                                    }
                                                                                                }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

@index(progressive) sequence<Box> boxes = scan(mp4_box);
entry boxes;
