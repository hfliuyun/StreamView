@spec("ITU-T H.264", "7.3.1")
@description("The eight-bit NAL unit header prefix.")
struct NalUnitHeader {
    bits<1> forbidden_zero_bit @equals(0)
        @description("Must be zero in a conforming NAL unit.");
    bits<2> nal_ref_idc
        @description("Indicates the reference priority of the NAL unit.");
    bits<5> nal_unit_type
        @description("Identifies the syntax carried by the NAL unit.");
}

@spec("ITU-T H.264", "7.3.2.4")
@description("The access unit delimiter raw byte sequence payload.")
struct AccessUnitDelimiterRbsp {
    bits<3> primary_pic_type
        @description("Constrains the slice types present in the following primary picture.");
    rbsp_trailing_bits;
}

enum SpsProfileIdc {
    baseline = 66;
    main = 77;
    extended = 88;
    high = 100;
}

@spec("ITU-T H.264", "7.3.2.1.1")
@description("The supported 8-bit 4:2:0 sequence parameter set core.")
struct SequenceParameterSetRbsp {
    bits<8> profile_idc @enum(SpsProfileIdc)
        @description("Identifies the supported H.264 profile.");
    bits<1> constraint_set0_flag;
    bits<1> constraint_set1_flag;
    bits<1> constraint_set2_flag;
    bits<1> constraint_set3_flag;
    bits<1> constraint_set4_flag;
    bits<1> constraint_set5_flag;
    bits<2> reserved_zero_2bits @equals(0);
    bits<8> level_idc
        @description("Identifies the H.264 level.");
    ue seq_parameter_set_id
        @description("Identifies this sequence parameter set.");
    if (profile_idc == 100) {
        ue chroma_format_idc @equals(1);
        ue bit_depth_luma_minus8 @equals(0);
        ue bit_depth_chroma_minus8 @equals(0);
        bits<1> qpprime_y_zero_transform_bypass_flag @equals(0);
        bits<1> seq_scaling_matrix_present_flag @equals(0);
    }
    ue log2_max_frame_num_minus4 @range(0, 12)
        @spec("ITU-T H.264", "7.4.2.1.1")
        @description("Sets the frame-number wrap; conformant values are 0 to 12.");
    ue pic_order_cnt_type @equals(0);
    ue log2_max_pic_order_cnt_lsb_minus4 @range(0, 12)
        @spec("ITU-T H.264", "7.4.2.1.1")
        @description("Sets the picture-order-count wrap; conformant values are 0 to 12.");
    ue max_num_ref_frames;
    bits<1> gaps_in_frame_num_value_allowed_flag;
    ue pic_width_in_mbs_minus1;
    ue pic_height_in_map_units_minus1;
    bits<1> frame_mbs_only_flag;
    if (frame_mbs_only_flag == 0) {
        bits<1> mb_adaptive_frame_field_flag;
    }
    bits<1> direct_8x8_inference_flag;
    bits<1> frame_cropping_flag;
    if (frame_cropping_flag == 1) {
        ue frame_crop_left_offset;
        ue frame_crop_right_offset;
        ue frame_crop_top_offset;
        ue frame_crop_bottom_offset;
    }
    bits<1> vui_parameters_present_flag @equals(0);
    rbsp_trailing_bits;
}

enum WeightedBipredIdc {
    disabled = 0;
    explicit_weighting = 1;
    implicit_weighting = 2;
}

@spec("ITU-T H.264", "7.3.2.2")
@description("The supported picture parameter set base syntax without slice groups or extensions.")
struct PictureParameterSetRbsp {
    ue pic_parameter_set_id @range(0, 255)
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Identifies this picture parameter set; conformant values are 0 to 255.");
    ue seq_parameter_set_id @range(0, 31)
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Identifies the referenced sequence parameter set; conformant values are 0 to 31.");
    bits<1> entropy_coding_mode_flag
        @description("Selects CAVLC or CABAC entropy coding for slices using this PPS.");
    bits<1> bottom_field_pic_order_in_frame_present_flag
        @description("Signals bottom-field picture-order syntax in associated slice headers.");
    ue num_slice_groups_minus1 @equals(0)
        @description("The supported base syntax contains one slice group.");
    ue num_ref_idx_l0_default_active_minus1 @range(0, 31)
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Sets the default list 0 reference count; conformant values are 0 to 31.");
    ue num_ref_idx_l1_default_active_minus1 @range(0, 31)
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Sets the default list 1 reference count; conformant values are 0 to 31.");
    bits<1> weighted_pred_flag
        @description("Enables weighted prediction for P and SP slices using this PPS.");
    bits<2> weighted_bipred_idc @enum(WeightedBipredIdc)
        @description("Selects the supported weighted biprediction mode.");
    se pic_init_qp_minus26
        @description("Sets the initial luma quantization parameter relative to 26.");
    se pic_init_qs_minus26
        @description("Sets the initial SP/SI quantization parameter relative to 26.");
    se chroma_qp_index_offset
        @description("Sets the first chroma quantization-parameter index offset.");
    bits<1> deblocking_filter_control_present_flag
        @description("Signals deblocking-filter control syntax in associated slice headers.");
    bits<1> constrained_intra_pred_flag
        @description("Restricts intra prediction to intra-coded neighboring macroblocks.");
    bits<1> redundant_pic_cnt_present_flag
        @description("Signals redundant-picture count syntax in associated slice headers.");
    rbsp_trailing_bits;
}

@index(progressive)
sequence<NalUnitHeader> nal_units = scan(h264_start_code);

@spec("ITU-T H.264", "7.3.1")
@description("Selects the payload syntax carried by each NAL unit type.")
payload<rbsp> nal_units switch (nal_unit_type) {
    case 7: SequenceParameterSetRbsp;
    case 8: PictureParameterSetRbsp;
    case 9: AccessUnitDelimiterRbsp;
    case 10: empty;
    case 11: empty;
}

entry nal_units;
