@spec("ITU-T H.264", "7.3.1")
@description("The eight-bit NAL unit header prefix.")
struct NalUnitHeader {
    bits<1> forbidden_zero_bit @equals(0)
        @description("Must be zero in a conforming NAL unit.");
    bits<2> nal_ref_idc
        @description("Indicates the reference priority of the NAL unit.");
    bits<5> nal_unit_type
        @description("Identifies the syntax carried by the NAL unit.");
    assert(nal_unit_type != 5 || nal_ref_idc != 0) at nal_ref_idc;
}

@spec("ITU-T H.264", "7.3.2.4")
@description("The access unit delimiter raw byte sequence payload.")
struct AccessUnitDelimiterRbsp {
    bits<3> primary_pic_type
        @description("Constrains the slice types present in the following primary picture.");
    rbsp_trailing_bits;
}

enum SpsProfileIdc {
    baseline = 66;
    main = 77;
    extended = 88;
    high = 100;
}

@spec("ITU-T H.264", "7.3.2.1.1")
@description("The supported 8-bit 4:2:0 sequence parameter set core.")
@context("h264-sps", seq_parameter_set_id)
struct SequenceParameterSetRbsp {
    bits<8> profile_idc @enum(SpsProfileIdc)
        @description("Identifies the supported H.264 profile.");
    bits<1> constraint_set0_flag;
    bits<1> constraint_set1_flag;
    bits<1> constraint_set2_flag;
    bits<1> constraint_set3_flag;
    bits<1> constraint_set4_flag;
    bits<1> constraint_set5_flag;
    bits<2> reserved_zero_2bits @equals(0);
    bits<8> level_idc
        @description("Identifies the H.264 level.");
    ue seq_parameter_set_id
        @description("Identifies this sequence parameter set.");
    if (profile_idc == 100) {
        ue chroma_format_idc @equals(1);
        ue bit_depth_luma_minus8 @equals(0);
        ue bit_depth_chroma_minus8 @equals(0);
        bits<1> qpprime_y_zero_transform_bypass_flag @equals(0);
        bits<1> seq_scaling_matrix_present_flag @equals(0);
    }
    ue log2_max_frame_num_minus4 @range(0, 12) @context_export
        @spec("ITU-T H.264", "7.4.2.1.1")
        @description("Sets the frame-number wrap; conformant values are 0 to 12.");
    ue pic_order_cnt_type @equals(0) @context_export;
    ue log2_max_pic_order_cnt_lsb_minus4 @range(0, 12) @context_export
        @spec("ITU-T H.264", "7.4.2.1.1")
        @description("Sets the picture-order-count wrap; conformant values are 0 to 12.");
    ue max_num_ref_frames;
    bits<1> gaps_in_frame_num_value_allowed_flag;
    ue pic_width_in_mbs_minus1;
    ue pic_height_in_map_units_minus1;
    bits<1> frame_mbs_only_flag @context_export;
    if (frame_mbs_only_flag == 0) {
        bits<1> mb_adaptive_frame_field_flag;
    }
    bits<1> direct_8x8_inference_flag;
    bits<1> frame_cropping_flag;
    if (frame_cropping_flag == 1) {
        ue frame_crop_left_offset;
        ue frame_crop_right_offset;
        ue frame_crop_top_offset;
        ue frame_crop_bottom_offset;
    }
    bits<1> vui_parameters_present_flag;
    if (vui_parameters_present_flag == 1) {
        bits<1> aspect_ratio_info_present_flag @spec("ITU-T H.264", "E.1.1");
        if (aspect_ratio_info_present_flag == 1) {
            bits<8> aspect_ratio_idc @spec("ITU-T H.264", "E.1.1");
            if (aspect_ratio_idc == 255) {
                bits<16> sar_width @spec("ITU-T H.264", "E.1.1");
                bits<16> sar_height @spec("ITU-T H.264", "E.1.1");
            }
        }
        bits<1> overscan_info_present_flag @spec("ITU-T H.264", "E.1.1");
        if (overscan_info_present_flag == 1) {
            bits<1> overscan_appropriate_flag @spec("ITU-T H.264", "E.1.1");
        }
        bits<1> video_signal_type_present_flag @spec("ITU-T H.264", "E.1.1");
        if (video_signal_type_present_flag == 1) {
            bits<3> video_format @spec("ITU-T H.264", "E.1.1");
            bits<1> video_full_range_flag @spec("ITU-T H.264", "E.1.1");
            bits<1> colour_description_present_flag @spec("ITU-T H.264", "E.1.1");
            if (colour_description_present_flag == 1) {
                bits<8> colour_primaries @spec("ITU-T H.264", "E.1.1");
                bits<8> transfer_characteristics @spec("ITU-T H.264", "E.1.1");
                bits<8> matrix_coefficients @spec("ITU-T H.264", "E.1.1");
            }
        }
        bits<1> chroma_loc_info_present_flag @spec("ITU-T H.264", "E.1.1");
        if (chroma_loc_info_present_flag == 1) {
            ue chroma_sample_loc_type_top_field @range(0, 5)
                @spec("ITU-T H.264", "E.2.1");
            ue chroma_sample_loc_type_bottom_field @range(0, 5)
                @spec("ITU-T H.264", "E.2.1");
        }
        bits<1> timing_info_present_flag @spec("ITU-T H.264", "E.1.1");
        if (timing_info_present_flag == 1) {
            bits<32> num_units_in_tick @spec("ITU-T H.264", "E.1.1");
            bits<32> time_scale @spec("ITU-T H.264", "E.1.1");
            bits<1> fixed_frame_rate_flag @spec("ITU-T H.264", "E.1.1");
        }
        bits<1> nal_hrd_parameters_present_flag @spec("ITU-T H.264", "E.1.1");
        if (nal_hrd_parameters_present_flag == 1) {
            ue nal_hrd_cpb_cnt_minus1 @range(0, 31)
                @spec("ITU-T H.264", "E.2.2");
            bits<4> nal_hrd_bit_rate_scale @spec("ITU-T H.264", "E.1.2");
            bits<4> nal_hrd_cpb_size_scale @spec("ITU-T H.264", "E.1.2");
            computed<u64> nal_hrd_cpb_count = nal_hrd_cpb_cnt_minus1 + 1;
            repeat (nal_hrd_cpb_count, 32) {
                ue nal_hrd_bit_rate_value_minus1 @spec("ITU-T H.264", "E.1.2");
                ue nal_hrd_cpb_size_value_minus1 @spec("ITU-T H.264", "E.1.2");
                bits<1> nal_hrd_cbr_flag @spec("ITU-T H.264", "E.1.2");
            }
            bits<5> nal_hrd_initial_cpb_removal_delay_length_minus1
                @spec("ITU-T H.264", "E.1.2");
            bits<5> nal_hrd_cpb_removal_delay_length_minus1
                @spec("ITU-T H.264", "E.1.2");
            bits<5> nal_hrd_dpb_output_delay_length_minus1
                @spec("ITU-T H.264", "E.1.2");
            bits<5> nal_hrd_time_offset_length @spec("ITU-T H.264", "E.1.2");
        }
        bits<1> vcl_hrd_parameters_present_flag @spec("ITU-T H.264", "E.1.1");
        if (vcl_hrd_parameters_present_flag == 1) {
            ue vcl_hrd_cpb_cnt_minus1 @range(0, 31)
                @spec("ITU-T H.264", "E.2.2");
            bits<4> vcl_hrd_bit_rate_scale @spec("ITU-T H.264", "E.1.2");
            bits<4> vcl_hrd_cpb_size_scale @spec("ITU-T H.264", "E.1.2");
            computed<u64> vcl_hrd_cpb_count = vcl_hrd_cpb_cnt_minus1 + 1;
            repeat (vcl_hrd_cpb_count, 32) {
                ue vcl_hrd_bit_rate_value_minus1 @spec("ITU-T H.264", "E.1.2");
                ue vcl_hrd_cpb_size_value_minus1 @spec("ITU-T H.264", "E.1.2");
                bits<1> vcl_hrd_cbr_flag @spec("ITU-T H.264", "E.1.2");
            }
            bits<5> vcl_hrd_initial_cpb_removal_delay_length_minus1
                @spec("ITU-T H.264", "E.1.2");
            bits<5> vcl_hrd_cpb_removal_delay_length_minus1
                @spec("ITU-T H.264", "E.1.2");
            bits<5> vcl_hrd_dpb_output_delay_length_minus1
                @spec("ITU-T H.264", "E.1.2");
            bits<5> vcl_hrd_time_offset_length @spec("ITU-T H.264", "E.1.2");
        }
        computed<bool> hrd_parameters_present =
            nal_hrd_parameters_present_flag == 1 || vcl_hrd_parameters_present_flag == 1;
        if (hrd_parameters_present) {
            bits<1> low_delay_hrd_flag @spec("ITU-T H.264", "E.1.1");
        }
        bits<1> pic_struct_present_flag @spec("ITU-T H.264", "E.1.1");
        bits<1> bitstream_restriction_flag @spec("ITU-T H.264", "E.1.1");
        if (bitstream_restriction_flag == 1) {
            bits<1> motion_vectors_over_pic_boundaries_flag
                @spec("ITU-T H.264", "E.1.1");
            ue max_bytes_per_pic_denom @range(0, 16)
                @spec("ITU-T H.264", "E.2.1");
            ue max_bits_per_mb_denom @range(0, 16)
                @spec("ITU-T H.264", "E.2.1");
            ue log2_max_mv_length_horizontal @range(0, 16)
                @spec("ITU-T H.264", "E.2.1");
            ue log2_max_mv_length_vertical @range(0, 16)
                @spec("ITU-T H.264", "E.2.1");
            ue max_num_reorder_frames @spec("ITU-T H.264", "E.1.1");
            ue max_dec_frame_buffering @spec("ITU-T H.264", "E.1.1");
        }
    }
    rbsp_trailing_bits;
}

enum WeightedBipredIdc {
    disabled = 0;
    explicit_weighting = 1;
    implicit_weighting = 2;
}

@spec("ITU-T H.264", "7.3.2.2")
@description("The supported picture parameter set base syntax without slice groups or extensions.")
@context("h264-pps", pic_parameter_set_id)
@context_dependency("h264-sps", seq_parameter_set_id)
struct PictureParameterSetRbsp {
    ue pic_parameter_set_id @range(0, 255)
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Identifies this picture parameter set; conformant values are 0 to 255.");
    ue seq_parameter_set_id @range(0, 31)
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Identifies the referenced sequence parameter set; conformant values are 0 to 31.");
    bits<1> entropy_coding_mode_flag @context_export
        @description("Selects CAVLC or CABAC entropy coding for slices using this PPS.");
    bits<1> bottom_field_pic_order_in_frame_present_flag @context_export
        @description("Signals bottom-field picture-order syntax in associated slice headers.");
    ue num_slice_groups_minus1 @equals(0)
        @description("The supported base syntax contains one slice group.");
    ue num_ref_idx_l0_default_active_minus1 @range(0, 31) @context_export
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Sets the default list 0 reference count; conformant values are 0 to 31.");
    ue num_ref_idx_l1_default_active_minus1 @range(0, 31) @context_export
        @spec("ITU-T H.264", "7.4.2.2")
        @description("Sets the default list 1 reference count; conformant values are 0 to 31.");
    bits<1> weighted_pred_flag @context_export
        @description("Enables weighted prediction for P and SP slices using this PPS.");
    bits<2> weighted_bipred_idc @enum(WeightedBipredIdc) @context_export
        @description("Selects the supported weighted biprediction mode.");
    se pic_init_qp_minus26
        @description("Sets the initial luma quantization parameter relative to 26.");
    se pic_init_qs_minus26
        @description("Sets the initial SP/SI quantization parameter relative to 26.");
    se chroma_qp_index_offset
        @description("Sets the first chroma quantization-parameter index offset.");
    bits<1> deblocking_filter_control_present_flag @context_export
        @description("Signals deblocking-filter control syntax in associated slice headers.");
    bits<1> constrained_intra_pred_flag
        @description("Restricts intra prediction to intra-coded neighboring macroblocks.");
    bits<1> redundant_pic_cnt_present_flag @context_export
        @description("Signals redundant-picture count syntax in associated slice headers.");
    rbsp_trailing_bits;
}

enum IdrAllISliceType {
    i = 2;
    all_i = 7;
}

enum NonIdrSliceType {
    p = 0;
    b = 1;
    i = 2;
    all_p = 5;
    all_b = 6;
    all_i = 7;
}

enum ModificationOfPicNumsIdc {
    subtract_short_term = 0;
    add_short_term = 1;
    long_term = 2;
    end = 3;
}

enum MemoryManagementControlOperation {
    end = 0;
    unmark_short_term = 1;
    unmark_long_term = 2;
    assign_long_term = 3;
    set_max_long_term_idx = 4;
    unmark_all = 5;
    mark_current_long_term = 6;
}

enum DisableDeblockingFilterIdc {
    enabled = 0;
    disabled = 1;
    enabled_within_slice = 2;
}

@spec("ITU-T H.264", "7.3.2.8, 7.3.3")
@description("The bounded all-I IDR slice header followed by an opaque slice-layer suffix.")
@context_import("h264-pps", pic_parameter_set_id)
struct IdrSliceLayerWithoutPartitioningRbsp {
    ue first_mb_in_slice
        @description("Identifies the first macroblock in this slice.");
    ue slice_type @enum(IdrAllISliceType)
        @description("Selects the supported all-I slice header form.");
    ue pic_parameter_set_id @range(0, 255)
        @description("Selects the active picture parameter set.");
    bits<(context_value(pic_parameter_set_id,
                        h264_sps,
                        log2_max_frame_num_minus4) + 4) /
         context_value(pic_parameter_set_id, h264_sps, frame_mbs_only_flag)> frame_num
        @description("Identifies the decoded picture within the frame-number wrap.");
    ue idr_pic_id
        @description("Identifies this IDR picture.");
    bits<(context_value(pic_parameter_set_id,
                        h264_sps,
                        log2_max_pic_order_cnt_lsb_minus4) + 4) /
         (1 - context_value(pic_parameter_set_id, h264_sps, pic_order_cnt_type))> pic_order_cnt_lsb
        @description("Carries the picture-order-count least-significant bits.");
    if (context_value(pic_parameter_set_id,
                      h264_pps,
                      bottom_field_pic_order_in_frame_present_flag) == 1) {
        se delta_pic_order_cnt_bottom
            @spec("ITU-T H.264", "7.3.3")
            @description("Carries the bottom-field picture-order-count delta.");
    }
    if (context_value(pic_parameter_set_id,
                      h264_pps,
                      redundant_pic_cnt_present_flag) == 1) {
        ue redundant_pic_cnt @range(0, 127)
            @spec("ITU-T H.264", "7.3.3, 7.4.3")
            @description("Identifies the redundant representation of this picture.");
    }
    bits<1> no_output_of_prior_pics_flag
        @description("Controls output of pictures preceding this IDR picture.");
    bits<1> long_term_reference_flag
        @description("Marks the IDR picture as a long-term reference when set.");
    se slice_qp_delta
        @description("Adjusts the initial luma quantization parameter for the slice.");
    if (context_value(pic_parameter_set_id,
                      h264_pps,
                      deblocking_filter_control_present_flag) == 1) {
        ue disable_deblocking_filter_idc @enum(DisableDeblockingFilterIdc)
            @spec("ITU-T H.264", "7.3.3, 7.4.3")
            @description("Selects the deblocking-filter mode for this slice.");
        if (disable_deblocking_filter_idc == 1) {
        } else {
            se slice_alpha_c0_offset_div2
                @spec("ITU-T H.264", "7.3.3, 7.4.3")
                @description("Carries half the alpha and c0 deblocking-filter offset.");
            se slice_beta_offset_div2
                @spec("ITU-T H.264", "7.3.3, 7.4.3")
                @description("Carries half the beta deblocking-filter offset.");
        }
    }
    compressed_payload slice_data
        @description("The opaque remaining slice-layer suffix, including slice trailing bits.")
        @spec("ITU-T H.264", "7.3.2.10");
}

@spec("ITU-T H.264", "7.3.2.8, 7.3.3")
@description("The bounded progressive I/P/B non-IDR slice header followed by an opaque suffix.")
@context_import("h264-pps", pic_parameter_set_id)
struct NonIdrSliceLayerWithoutPartitioningRbsp {
    ue first_mb_in_slice
        @description("Identifies the first macroblock in this slice.");
    ue slice_type @enum(NonIdrSliceType)
        @description("Selects the supported non-IDR I, P, or B slice header form.");
    computed<bool> is_p_slice = slice_type == 0 || slice_type == 5;
    computed<bool> is_b_slice = slice_type == 1 || slice_type == 6;
    computed<bool> uses_reference_lists = is_p_slice || is_b_slice;
    ue pic_parameter_set_id @range(0, 255)
        @description("Selects the active picture parameter set.");
    bits<(context_value(pic_parameter_set_id,
                        h264_sps,
                        log2_max_frame_num_minus4) + 4) /
         context_value(pic_parameter_set_id, h264_sps, frame_mbs_only_flag)> frame_num
        @description("Identifies the decoded picture within the frame-number wrap.");
    bits<(context_value(pic_parameter_set_id,
                        h264_sps,
                        log2_max_pic_order_cnt_lsb_minus4) + 4) /
         (1 - context_value(pic_parameter_set_id, h264_sps, pic_order_cnt_type))> pic_order_cnt_lsb
        @description("Carries the picture-order-count least-significant bits.");
    if (context_value(pic_parameter_set_id,
                      h264_pps,
                      bottom_field_pic_order_in_frame_present_flag) == 1) {
        se delta_pic_order_cnt_bottom
            @spec("ITU-T H.264", "7.3.3")
            @description("Carries the bottom-field picture-order-count delta.");
    }
    if (context_value(pic_parameter_set_id,
                      h264_pps,
                      redundant_pic_cnt_present_flag) == 1) {
        ue redundant_pic_cnt @range(0, 127)
            @spec("ITU-T H.264", "7.3.3, 7.4.3")
            @description("Identifies the redundant representation of this picture.");
    }
    if (is_b_slice) {
        bits<1> direct_spatial_mv_pred_flag
            @spec("ITU-T H.264", "7.3.3")
            @description("Selects spatial or temporal direct motion-vector prediction.");
    }
    if (uses_reference_lists) {
        bits<1> num_ref_idx_active_override_flag
            @spec("ITU-T H.264", "7.3.3")
            @description("Selects slice-level active-reference count overrides.");
        if (num_ref_idx_active_override_flag == 1) {
            ue num_ref_idx_l0_active_minus1 @range(0, 31)
                @spec("ITU-T H.264", "7.3.3, 7.4.3")
                @description("Overrides the active list 0 entry count for this slice.");
            if (is_b_slice) {
                ue num_ref_idx_l1_active_minus1 @range(0, 31)
                    @spec("ITU-T H.264", "7.3.3, 7.4.3")
                    @description("Overrides the active list 1 entry count for this B slice.");
            }
        }
        bits<1> ref_pic_list_modification_flag_l0
            @spec("ITU-T H.264", "7.3.3")
            @description("Selects list 0 reference-picture modification syntax.");
        if (ref_pic_list_modification_flag_l0 == 1) {
            repeat (64) {
                ue modification_of_pic_nums_idc @enum(ModificationOfPicNumsIdc)
                    @spec("ITU-T H.264", "7.3.3, 7.4.3")
                    @description("Selects the next list 0 modification operation.");
                computed<bool> uses_abs_diff_pic_num =
                    modification_of_pic_nums_idc == 0 ||
                    modification_of_pic_nums_idc == 1;
                if (uses_abs_diff_pic_num) {
                    ue abs_diff_pic_num_minus1
                        @spec("ITU-T H.264", "7.3.3, 7.4.3")
                        @description("Carries the short-term picture-number difference.");
                }
                if (modification_of_pic_nums_idc == 2) {
                    ue long_term_pic_num
                        @spec("ITU-T H.264", "7.3.3, 7.4.3")
                        @description("Selects a long-term reference picture.");
                }
            } until (modification_of_pic_nums_idc == 3);
        }
        if (is_b_slice) {
            bits<1> ref_pic_list_modification_flag_l1
                @spec("ITU-T H.264", "7.3.3")
                @description("Selects list 1 reference-picture modification syntax.");
            if (ref_pic_list_modification_flag_l1 == 1) {
                repeat (64) {
                    ue modification_of_pic_nums_idc_l1 @enum(ModificationOfPicNumsIdc)
                        @spec("ITU-T H.264", "7.3.3, 7.4.3")
                        @description("Selects the next list 1 modification operation.");
                    computed<bool> uses_abs_diff_pic_num_l1 =
                        modification_of_pic_nums_idc_l1 == 0 ||
                        modification_of_pic_nums_idc_l1 == 1;
                    if (uses_abs_diff_pic_num_l1) {
                        ue abs_diff_pic_num_minus1_l1
                            @spec("ITU-T H.264", "7.3.3, 7.4.3")
                            @description("Carries the list 1 picture-number difference.");
                    }
                    if (modification_of_pic_nums_idc_l1 == 2) {
                        ue long_term_pic_num_l1
                            @spec("ITU-T H.264", "7.3.3, 7.4.3")
                            @description("Selects a list 1 long-term reference picture.");
                    }
                } until (modification_of_pic_nums_idc_l1 == 3);
            }
        }
    }
    assert(!is_p_slice ||
           context_value(pic_parameter_set_id, h264_pps, weighted_pred_flag) == 0)
        at pic_parameter_set_id;
    assert(!is_b_slice ||
           context_value(pic_parameter_set_id, h264_pps, weighted_bipred_idc) != 1)
        at pic_parameter_set_id;
    if (header_value(nal_ref_idc) == 0) {
    } else {
        bits<1> adaptive_ref_pic_marking_mode_flag
            @spec("ITU-T H.264", "7.3.3.3")
            @description("Selects sliding-window or adaptive reference-picture marking.");
        if (adaptive_ref_pic_marking_mode_flag == 1) {
            repeat (64) {
                ue memory_management_control_operation
                    @enum(MemoryManagementControlOperation)
                    @spec("ITU-T H.264", "7.3.3.3, 7.4.3.3")
                    @description("Selects the next reference-picture marking operation.");
                computed<bool> marking_uses_pic_num_difference =
                    memory_management_control_operation == 1 ||
                    memory_management_control_operation == 3;
                if (marking_uses_pic_num_difference) {
                    ue difference_of_pic_nums_minus1
                        @spec("ITU-T H.264", "7.3.3.3, 7.4.3.3")
                        @description("Identifies a short-term picture to operate on.");
                }
                if (memory_management_control_operation == 2) {
                    ue long_term_pic_num_mmco
                        @spec("ITU-T H.264", "7.3.3.3, 7.4.3.3")
                        @description("Identifies a long-term picture to unmark.");
                }
                computed<bool> marking_uses_long_term_frame_idx =
                    memory_management_control_operation == 3 ||
                    memory_management_control_operation == 6;
                if (marking_uses_long_term_frame_idx) {
                    ue long_term_frame_idx
                        @spec("ITU-T H.264", "7.3.3.3, 7.4.3.3")
                        @description("Assigns the long-term frame index.");
                }
                if (memory_management_control_operation == 4) {
                    ue max_long_term_frame_idx_plus1
                        @spec("ITU-T H.264", "7.3.3.3, 7.4.3.3")
                        @description("Sets the maximum long-term frame index plus one.");
                }
            } until (memory_management_control_operation == 0);
        }
    }
    if (uses_reference_lists) {
        if (context_value(pic_parameter_set_id,
                          h264_pps,
                          entropy_coding_mode_flag) == 1) {
            ue cabac_init_idc @range(0, 2)
                @spec("ITU-T H.264", "7.3.3, 7.4.3")
                @description("Selects the CABAC context initialization table.");
        }
    }
    se slice_qp_delta
        @description("Adjusts the initial luma quantization parameter for the slice.");
    if (context_value(pic_parameter_set_id,
                      h264_pps,
                      deblocking_filter_control_present_flag) == 1) {
        ue disable_deblocking_filter_idc @enum(DisableDeblockingFilterIdc)
            @spec("ITU-T H.264", "7.3.3, 7.4.3")
            @description("Selects the deblocking-filter mode for this slice.");
        if (disable_deblocking_filter_idc == 1) {
        } else {
            se slice_alpha_c0_offset_div2
                @spec("ITU-T H.264", "7.3.3, 7.4.3")
                @description("Carries half the alpha and c0 deblocking-filter offset.");
            se slice_beta_offset_div2
                @spec("ITU-T H.264", "7.3.3, 7.4.3")
                @description("Carries half the beta deblocking-filter offset.");
        }
    }
    compressed_payload slice_data
        @description("The opaque remaining slice-layer suffix, including slice trailing bits.")
        @spec("ITU-T H.264", "7.3.2.10");
}

@index(progressive)
sequence<NalUnitHeader> nal_units = scan(h264_start_code);

@spec("ITU-T H.264", "7.3.1")
@description("Selects the payload syntax carried by each NAL unit type.")
payload<rbsp> nal_units switch (nal_unit_type) {
    case 1: NonIdrSliceLayerWithoutPartitioningRbsp;
    case 5: IdrSliceLayerWithoutPartitioningRbsp;
    case 7: SequenceParameterSetRbsp;
    case 8: PictureParameterSetRbsp;
    case 9: AccessUnitDelimiterRbsp;
    case 10: empty;
    case 11: empty;
}

entry nal_units;
